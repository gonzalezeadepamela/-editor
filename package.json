{
  "name": "editor-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "tsx server/index.ts",
    "client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "studio": "remotion studio src/remotion.ts --no-open",
    "setup": "bash scripts/setup.sh",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/captions": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.533",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@remotion/cli": "4.0.533",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
